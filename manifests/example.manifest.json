{
  "lab": "Inventory",
  "studio": "Catalog",
  "description": "Products, suppliers and stock levels",
  "enums": [
    {
      "name": "ProductStatus",
      "values": ["DRAFT", "ACTIVE", "ARCHIVED"]
    }
  ],
  "relationships": [
    {
      "from": "Product",
      "to": "Supplier",
      "required": false,
      "collection": "products"
    }
  ],
  "operations": {
    "Supplier": ["read", "create", "update"]
  },
  "search": {
    "Product": ["name", "sku"],
    "Supplier": ["name"]
  },
  "sort": {
    "Product": ["name", "createdAt"]
  },
  "models": [
    {
      "name": "Product",
      "label": "Product",
      "dtos": {
        "create": ["name", "sku", "quantity", "price", "status", "isActive", "description"],
        "update": ["name", "quantity", "price", "status", "isActive", "description"],
        "query": ["name", "sku", "quantity", "price", "status", "isActive"]
      },
      "customMethods": [
        {
          "name": "findOneBySku",
          "operation": "findOneBy",
          "fields": ["sku"]
        },
        {
          "name": "findManyByStatus",
          "operation": "findManyBy",
          "fields": ["status"]
        },
        {
          "name": "countByStatus",
          "operation": "countBy",
          "fields": ["status"]
        },
        {
          "name": "isExistedBySku",
          "operation": "isExistedBy",
          "fields": ["sku"]
        }
      ],
      "fields": [
        { "name": "name", "type": "string", "required": true, "unique": true },
        { "name": "sku", "type": "string", "required": true, "unique": true },
        { "name": "quantity", "type": "int", "required": true, "default": 0 },
        { "name": "price", "type": "decimal", "required": true },
        {
          "name": "status",
          "type": "enum",
          "enum": "ProductStatus",
          "required": true
        },
        {
          "name": "isActive",
          "type": "boolean",
          "required": true,
          "default": true
        },
        {
          "name": "releasedOn",
          "type": "date",
          "required": false,
          "nullable": true
        },
        {
          "name": "description",
          "type": "text",
          "required": false,
          "nullable": true
        },
        {
          "name": "attributes",
          "type": "json",
          "required": false,
          "nullable": true
        },
        {
          "name": "tags",
          "type": "array",
          "items": "string",
          "required": false
        }
      ]
    },
    {
      "name": "Supplier",
      "label": "Supplier",
      "fields": [
        { "name": "name", "type": "string", "required": true },
        { "name": "email", "type": "string", "required": true },
        {
          "name": "phone",
          "type": "string",
          "required": false,
          "nullable": true
        },
        {
          "name": "active",
          "type": "boolean",
          "required": true,
          "default": true
        }
      ]
    }
  ]
}
