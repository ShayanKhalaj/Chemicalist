// Prisma schema generated from the registered Chemicalist manifests.
// Managed by the generator: edit manifests, then re-run `chemicalist generate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "compliance", "ehs", "finance", "human_resources", "inventory", "laboratory", "logistics", "maintenance_assets", "planning", "process_engineering", "product", "production", "quality", "research_development", "sales_distribution", "supply_chain"]
}

