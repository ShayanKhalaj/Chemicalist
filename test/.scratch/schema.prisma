model PlanningDemandForecast {
  id String @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  reference String @unique
  name String
  status PlanningStudioRecordStatus @default(DRAFT)
  description String? @db.Text
  periodStart DateTime
  periodEnd DateTime
  scenario String?
  plannedQuantity Decimal? @db.Decimal(18, 4)
  committedQuantity Decimal? @db.Decimal(18, 4)
  unit String?
  planningLevel String?
  approvedAt DateTime?
  approvedByReference String?
  assumptions Json?
  version String?
  frozen Boolean?
  campaignReference String?
  processMode String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([name])
  @@index([status])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([scenario])
  @@index([planningLevel])
  @@index([version])
  @@index([campaignReference])
  @@index([processMode])
  @@map("planning_demand_forecast")
  @@schema("planning")
}
